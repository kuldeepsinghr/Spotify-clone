# Read by docker compose for the database containers. Copy to .env and change the passwords.
POSTGRES_USER=spotify
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spotify
POSTGRES_PORT=5432

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# Optional: override the api container's dev-only token secrets (these take precedence over backend/.env).
# JWT_ACCESS_SECRET=
# REFRESH_TOKEN_SECRET=

# Copy to backend/.env. Never commit the real file.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Host-side connection. Inside docker compose the api service overrides this to use the "postgres" host.
DATABASE_URL=postgresql://spotify:change-me@127.0.0.1:5432/spotify?schema=public
# Integration tests run against this database and wipe it between tests.
TEST_DATABASE_URL=postgresql://spotify:change-me@127.0.0.1:5432/spotify_test?schema=public

# Comma-separated list of front end origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Number of reverse proxies in front of the API (set 1 on Render); rate limits key on the client IP.
TRUST_PROXY=0

# Auth. At least 32 random characters each, and different from each other. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Values starting with dev-only- are rejected when NODE_ENV=production.
JWT_ACCESS_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in production. SameSite=none (front end on another site) requires secure cookies.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Guests hear this many seconds of each track; 0 gives guests no audio at all.
GUEST_PREVIEW_SECONDS=30

# Used once by `npm run db:seed` to create or promote the first admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Only needed by `npm run migrate:mongo -- --source mongo`
MONGODB_URI=

{
  "name": "spotify-clone-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "backup:legacy": "tsx scripts/backup-legacy-api.ts",
    "migrate:mongo": "tsx scripts/migrate-mongo.ts",
    "verify:migration": "tsx scripts/verify-migration.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "6.19.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "mongodb": "^6.21.0",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  }
}
